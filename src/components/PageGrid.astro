---
import type { Locale } from '../i18n';
import CapabilityGrid from './landing/CapabilityGrid.astro';
import ExecutionShowcase from './landing/ExecutionShowcase.astro';
import LandingHero from './landing/LandingHero.astro';
import ProofTrust from './landing/ProofTrust.astro';
import ReleaseStatus from './landing/ReleaseStatus.astro';
import ScrollReveal from './ScrollReveal.astro';
import TriArchitecture from './TriArchitecture.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<div class="relative mx-auto max-w-[1400px] border-x border-t border-subtle/77">
  <div class="grid-dot absolute -top-[3px] -left-[3px] z-20"></div>
  <div class="grid-dot absolute -top-[3px] -right-[3px] z-20"></div>

  <LandingHero locale={locale} />

  <div id="release-status" class="scroll-mt-28">
    <ReleaseStatus locale={locale} />
  </div>

  <div id="capabilities" class="scroll-mt-28">
    <CapabilityGrid locale={locale} />
  </div>

  <TriArchitecture locale={locale} />
  <ExecutionShowcase locale={locale} />

  <div id="proof-trust" class="scroll-mt-28">
    <ProofTrust locale={locale} />
  </div>
</div>
<ScrollReveal />
