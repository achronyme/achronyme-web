---
import type { Locale } from '../../i18n';
import { t } from '../../i18n';
import { releaseDocs, releaseStatus } from '../../data/release-status';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = t(locale);
const copy = s.releaseStatus;
const cards = [
  {
    name: copy.core,
    description: copy.coreDesc,
    stable: releaseStatus.core.stable,
    candidate: releaseStatus.core.candidate,
    href: releaseStatus.core.stableUrl,
    dotClass: 'bg-proof',
  },
  {
    name: copy.editor,
    description: copy.editorDesc,
    stable: releaseStatus.editor.stable,
    candidate: releaseStatus.editor.candidate,
    href: releaseStatus.editor.stableUrl,
    dotClass: 'bg-info',
  },
] as const;
---

<section aria-labelledby="release-status-title" class="relative border-b border-subtle/77 px-7 py-16 sm:px-10 lg:px-14 lg:py-24">
  <div aria-hidden="true" class="landing-orb landing-orb-info -right-52 top-12"></div>
  <div class="relative z-10 grid gap-10 lg:grid-cols-[0.82fr_1.18fr] lg:gap-16">
    <div class="reveal max-w-xl">
      <span class="section-kicker">{copy.eyebrow}</span>
      <h2 id="release-status-title" class="mt-5 text-3xl font-bold tracking-tight sm:text-5xl">{copy.title}</h2>
      <p class="mt-5 text-lg leading-relaxed text-text-secondary">{copy.subtitle}</p>
      <a href={releaseDocs[locale]} class="receipt-link mt-7 inline-flex items-center gap-2 text-sm font-medium text-proof-light hover:text-proof">
        <span>{s.proofTrust.readGuide}</span>
        <span class="receipt-arrow ms-icon ms-icon-sm">arrow_outward</span>
      </a>
    </div>

    <div class="grid gap-4">
      {cards.map((card) => (
        <article class="reveal overflow-hidden rounded-2xl bg-white/[0.025] p-1.5 ring-1 ring-white/[0.07]">
          <div class="grid gap-5 rounded-[calc(1rem-0.375rem)] bg-[#0C0C12] p-5 ring-1 ring-white/[0.06] sm:grid-cols-[1fr_auto] sm:items-center sm:p-6">
            <div>
              <div class="flex items-center gap-2">
                <span class={`h-2 w-2 rounded-full ${card.dotClass}`}></span>
                <h3 class="font-semibold text-text-primary">{card.name}</h3>
              </div>
              <p class="mt-2 max-w-xl text-sm leading-relaxed text-text-muted">{card.description}</p>
            </div>
            <div class="grid min-w-[220px] grid-cols-2 gap-2 font-mono">
              <a href={card.href} target="_blank" rel="noopener noreferrer" class="rounded-xl bg-valid/[0.06] p-3 ring-1 ring-valid/15 transition-colors hover:bg-valid/[0.10]">
                <span class="block text-[10px] uppercase tracking-[0.15em] text-valid">{copy.published}</span>
                <span class="mt-1 block text-lg font-semibold text-text-primary">v{card.stable}</span>
              </a>
              <a href={releaseDocs[locale]} class="rounded-xl bg-proof/[0.06] p-3 ring-1 ring-proof/15 transition-colors hover:bg-proof/[0.10]">
                <span class="block text-[10px] uppercase tracking-[0.15em] text-proof-light">{copy.review}</span>
                <span class="mt-1 block text-lg font-semibold text-text-primary">v{card.candidate}</span>
              </a>
            </div>
          </div>
        </article>
      ))}

      <article class="reveal overflow-hidden rounded-2xl bg-white/[0.025] p-1.5 ring-1 ring-white/[0.07]">
        <div class="grid gap-5 rounded-[calc(1rem-0.375rem)] bg-[#0C0C12] p-5 ring-1 ring-white/[0.06] sm:grid-cols-[1fr_auto] sm:items-center sm:p-6">
          <div>
            <div class="flex items-center gap-2">
              <span class="h-2 w-2 rounded-full bg-warn"></span>
              <h3 class="font-semibold text-text-primary">{copy.web}</h3>
            </div>
            <p class="mt-2 max-w-xl text-sm leading-relaxed text-text-muted">{copy.webDesc}</p>
          </div>
          <div class="flex min-w-[220px] items-center justify-between gap-4 rounded-xl bg-warn/[0.05] p-3 ring-1 ring-warn/15">
            <div>
              <span class="block font-mono text-[10px] uppercase tracking-[0.15em] text-warn">{copy.live}</span>
              <span class="mt-1 block text-sm font-semibold text-text-primary">play.achrony.me</span>
            </div>
            <span class="rounded-lg bg-white/[0.05] px-2.5 py-1 font-mono text-sm text-text-secondary">v{releaseStatus.web.candidate}</span>
          </div>
        </div>
      </article>
    </div>
  </div>

  <div class="reveal relative z-10 mt-8 flex flex-wrap items-center gap-2 rounded-xl bg-black/20 px-4 py-3 font-mono text-xs text-text-muted ring-1 ring-white/[0.06]">
    <span class="text-text-secondary">{copy.source}:</span>
    <code class="break-all text-proof-light">{releaseStatus.core.candidateRevision}</code>
  </div>
</section>
