---
import type { Locale } from '../../i18n';
import { t } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale).capabilities;
const cards = [
  { key: 'concurrency', icon: 'account_tree', iconClass: 'text-proof-light', glow: 'from-proof/15' },
  { key: 'authority', icon: 'shield_lock', iconClass: 'text-warn', glow: 'from-warn/10' },
  { key: 'native', icon: 'memory', iconClass: 'text-valid', glow: 'from-valid/10' },
  { key: 'circuits', icon: 'schema', iconClass: 'text-info', glow: 'from-info/10' },
  { key: 'interop', icon: 'hub', iconClass: 'text-proof-light', glow: 'from-proof/15' },
  { key: 'trust', icon: 'key', iconClass: 'text-valid', glow: 'from-valid/10' },
] as const;
---

<section aria-labelledby="capabilities-title" class="relative border-b border-subtle/77 px-7 py-16 sm:px-10 lg:px-14 lg:py-24">
  <div class="reveal max-w-3xl">
    <span class="section-kicker">{copy.eyebrow}</span>
    <h2 id="capabilities-title" class="mt-5 text-3xl font-bold tracking-tight sm:text-5xl">{copy.title}</h2>
    <p class="mt-5 text-lg leading-relaxed text-text-secondary">{copy.subtitle}</p>
  </div>

  <div class="reveal-stagger mt-12 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
    {cards.map((card, index) => {
      const item = copy.items[card.key];
      return (
        <article class="reveal group relative min-h-[250px] overflow-hidden rounded-2xl bg-white/[0.025] p-1.5 ring-1 ring-white/[0.07]">
          <div class={`absolute inset-0 bg-gradient-to-br ${card.glow} via-transparent to-transparent opacity-40 transition-opacity duration-500 group-hover:opacity-80`}></div>
          <div class="relative flex h-full flex-col rounded-[calc(1rem-0.375rem)] bg-[#0C0C12]/90 p-6 ring-1 ring-white/[0.06] backdrop-blur-sm">
            <div class="flex items-start justify-between gap-4">
              <span class={`grid h-11 w-11 place-items-center rounded-xl bg-white/[0.04] ring-1 ring-white/[0.08] ${card.iconClass}`}>
                <span class="ms-icon ms-icon-lg">{card.icon}</span>
              </span>
              <span class="font-mono text-xs text-text-muted">0{index + 1}</span>
            </div>
            <h3 class="mt-7 text-xl font-semibold tracking-tight text-text-primary">{item.title}</h3>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-text-secondary">{item.desc}</p>
            <span class="mt-6 inline-flex w-fit rounded-md bg-white/[0.035] px-2.5 py-1 font-mono text-xs text-text-muted ring-1 ring-white/[0.06]">{item.meta}</span>
          </div>
        </article>
      );
    })}
  </div>
</section>
