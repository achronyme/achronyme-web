---
import type { Locale } from '../../i18n';
import { t } from '../../i18n';
import TerminalMockup from '../TerminalMockup.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = t(locale);
---

<section class="relative border-b border-subtle/77">
  <div class="grid-dot absolute -bottom-[3px] -left-[3px] z-10"></div>
  <div class="grid-dot absolute -bottom-[3px] -right-[3px] z-10"></div>

  <div class="grid lg:grid-cols-2">
    <article class="border-b border-subtle/77 p-7 sm:p-10 lg:border-b-0 lg:border-r lg:p-12">
      <span class="section-kicker text-valid ring-valid/20">HOST</span>
      <h2 class="mt-5 text-3xl font-bold tracking-tight sm:text-4xl">{s.featureVM.title}</h2>
      <p class="mt-4 max-w-xl leading-relaxed text-text-secondary">{s.featureVM.desc}</p>

      <div class="reveal mt-8">
        <TerminalMockup filename="pipeline.ach" badge="structured" badgeColor="text-valid">
          <pre><code><span class="text-proof-light">fn</span> <span class="text-info">work</span>(value) <span class="text-text-muted">&#123;</span>
  <span class="text-proof-light">await</span> <span class="text-info">yield_now</span>()
  <span class="text-proof-light">return</span> value * <span class="text-warn">2</span>
<span class="text-text-muted">&#125;</span>

<span class="text-proof-light">let</span> total = <span class="text-proof font-semibold">concurrent</span> <span class="text-text-muted">&#123;</span>
  <span class="text-proof-light">let</span> left = <span class="text-proof font-semibold">spawn</span> <span class="text-info">work</span>(<span class="text-warn">10</span>)
  <span class="text-proof-light">let</span> right = <span class="text-proof font-semibold">spawn</span> <span class="text-info">work</span>(<span class="text-warn">11</span>)
  <span class="text-proof font-semibold">await</span> left + <span class="text-proof font-semibold">await</span> right
<span class="text-text-muted">&#125;</span></code></pre>
        </TerminalMockup>
      </div>

      <div class="reveal mt-4 rounded-xl bg-black/25 p-4 font-mono text-xs leading-relaxed text-text-secondary ring-1 ring-white/[0.06]">
        <span class="text-valid">$</span> ach --allow-read ./data --max-tasks 32 run pipeline.ach --engine jit
      </div>
    </article>

    <article class="relative overflow-hidden p-7 sm:p-10 lg:p-12">
      <div aria-hidden="true" class="landing-orb landing-orb-proof -right-40 -top-40"></div>
      <div class="relative">
        <span class="section-kicker text-info ring-info/20">CIRCUIT</span>
        <h2 class="mt-5 text-3xl font-bold tracking-tight sm:text-4xl">{s.featureCircuit.title}</h2>
        <p class="mt-4 max-w-xl leading-relaxed text-text-secondary">{s.featureCircuit.desc}</p>

        <div class="reveal mt-8">
          <TerminalMockup filename="terminal" badge="artifacts" badgeColor="text-info">
            <pre><code><span class="text-valid">$</span> ach --prime bn254 circuit vote.ach \
    --input-file inputs.toml \
    --r1cs build/vote.r1cs \
    --wtns build/vote.wtns

<span class="text-valid">R1CS generated</span>
<span class="text-text-secondary">  build/vote.r1cs</span>
<span class="text-text-secondary">  build/vote.wtns</span>
<span class="text-valid">Witness constraints verified</span></code></pre>
          </TerminalMockup>
        </div>

        <div class="reveal mt-4 grid gap-3 sm:grid-cols-2">
          <div class="rounded-xl bg-info/[0.05] p-4 ring-1 ring-info/15">
            <span class="block text-sm font-semibold text-text-primary">{s.featureSolidity.title}</span>
            <span class="mt-2 block text-xs leading-relaxed text-text-muted">{s.featureSolidity.desc}</span>
          </div>
          <div class="rounded-xl bg-proof/[0.05] p-4 ring-1 ring-proof/15">
            <span class="block text-sm font-semibold text-text-primary">{s.featureProve.title}</span>
            <span class="mt-2 block text-xs leading-relaxed text-text-muted">{s.featureProve.desc}</span>
          </div>
        </div>
      </div>
    </article>
  </div>
</section>
