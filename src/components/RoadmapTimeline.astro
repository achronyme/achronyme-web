---
import type { Locale } from '../i18n';
import { t } from '../i18n';
import { releaseDocs, releaseStatus } from '../data/release-status';
import ScrollReveal from './ScrollReveal.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const r = t(locale).roadmap;
const stableItems = ['multiPrime', 'proveIR', 'solidity', 'r1csOptimizer'] as const;
const candidateItems = ['circomFrontend', 'adversarialTests'] as const;
const nextItems = ['playground', 'multiFieldVM'] as const;
const researchItems = ['starkBackend', 'noirFrontend', 'rustSDK'] as const;
---

<div class="mx-auto max-w-[1400px] border-x border-t border-subtle/77">
  <section class="relative overflow-hidden border-b border-subtle/77 px-7 py-14 sm:px-10 lg:px-16 lg:py-20">
    <div aria-hidden="true" class="landing-grid absolute inset-0 opacity-25"></div>
    <div aria-hidden="true" class="landing-orb landing-orb-proof -right-48 -top-48"></div>
    <div class="relative z-10">
      <span class="section-kicker">{r.livingPill}</span>
      <h1 class="mt-6 max-w-4xl text-4xl font-bold tracking-tight sm:text-6xl">{r.title}</h1>
      <p class="mt-5 max-w-3xl text-lg leading-relaxed text-text-secondary sm:text-xl">{r.subtitle}</p>

      <div class="mt-10 grid grid-cols-2 gap-3 lg:grid-cols-4">
        <div class="rounded-xl bg-[#0C0C12] p-4 ring-1 ring-white/[0.08]">
          <span class="block font-mono text-2xl font-semibold text-valid">v{releaseStatus.core.stable}</span>
          <span class="mt-1 block text-xs uppercase tracking-[0.16em] text-text-muted">{r.metrics.version}</span>
        </div>
        <div class="rounded-xl bg-[#0C0C12] p-4 ring-1 ring-white/[0.08]">
          <span class="block font-mono text-2xl font-semibold text-proof-light">v{releaseStatus.core.candidate}</span>
          <span class="mt-1 block text-xs uppercase tracking-[0.16em] text-text-muted">{r.status.inProgress}</span>
        </div>
        <div class="rounded-xl bg-[#0C0C12] p-4 ring-1 ring-white/[0.08]">
          <span class="block text-2xl font-semibold text-info">green</span>
          <span class="mt-1 block text-xs uppercase tracking-[0.16em] text-text-muted">{r.metrics.tests}</span>
        </div>
        <div class="rounded-xl bg-[#0C0C12] p-4 ring-1 ring-white/[0.08]">
          <span class="block font-mono text-2xl font-semibold text-warn">Apache-2.0</span>
          <span class="mt-1 block text-xs uppercase tracking-[0.16em] text-text-muted">{r.metrics.deps}</span>
        </div>
      </div>
    </div>
  </section>

  <div class="relative before:absolute before:bottom-0 before:left-[31px] before:top-0 before:w-px before:bg-gradient-to-b before:from-valid/50 before:via-proof/35 before:to-transparent md:before:left-[47px]">
    <section id="stable" class="relative border-b border-subtle/77 px-7 py-12 pl-16 sm:px-10 sm:pl-20 lg:px-16 lg:pl-24">
      <span aria-hidden="true" class="absolute left-[25px] top-14 h-3.5 w-3.5 rounded-full bg-valid ring-4 ring-valid/15 md:left-[41px]"></span>
      <header class="reveal">
        <div class="flex flex-wrap items-center gap-3">
          <span class="rounded-full bg-valid/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.16em] text-valid ring-1 ring-valid/20">{r.status.shipped}</span>
          <span class="font-mono text-sm text-text-primary">v{releaseStatus.core.stable}</span>
        </div>
        <h2 class="mt-4 text-3xl font-bold tracking-tight">{r.phases.now.label}</h2>
        <p class="mt-3 max-w-3xl text-text-muted">{r.phases.now.desc}</p>
      </header>

      <div class="reveal-stagger mt-8 grid gap-4 md:grid-cols-2">
        {stableItems.map((key) => (
          <article class="reveal rounded-2xl bg-valid/[0.035] p-6 ring-1 ring-valid/12">
            <h3 class="font-semibold text-text-primary">{r.items[key]}</h3>
            <p class="mt-3 text-sm leading-relaxed text-text-secondary">{r.items[`${key}Desc`]}</p>
          </article>
        ))}
      </div>

      <a href={releaseStatus.core.stableUrl} target="_blank" rel="noopener noreferrer" class="receipt-link mt-7 inline-flex items-center gap-2 text-sm text-valid hover:text-valid-light">
        <span>{r.receipts.viewRelease} v{releaseStatus.core.stable}</span>
        <span class="receipt-arrow ms-icon ms-icon-sm">arrow_outward</span>
      </a>
    </section>

    <section id="candidate" class="relative border-b border-subtle/77 px-7 py-12 pl-16 sm:px-10 sm:pl-20 lg:px-16 lg:pl-24">
      <span aria-hidden="true" class="wip-pulse absolute left-[25px] top-14 h-3.5 w-3.5 rounded-full bg-proof ring-4 ring-proof/15 md:left-[41px]"></span>
      <header class="reveal">
        <div class="flex flex-wrap items-center gap-3">
          <span class="rounded-full bg-proof/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.16em] text-proof-light ring-1 ring-proof/25">{r.status.inProgress}</span>
          <span class="font-mono text-sm text-text-primary">v{releaseStatus.core.candidate}</span>
          <span class="font-mono text-xs text-text-muted">{releaseStatus.core.candidateRevision.slice(0, 12)}</span>
        </div>
        <h2 class="mt-4 text-3xl font-bold tracking-tight">{r.phases.wip.label}</h2>
        <p class="mt-3 max-w-3xl text-text-muted">{r.phases.wip.desc}</p>
      </header>

      <div class="reveal-stagger mt-8 grid gap-4 lg:grid-cols-2">
        {candidateItems.map((key, index) => (
          <article class="reveal relative overflow-hidden rounded-2xl bg-proof/[0.04] p-6 ring-1 ring-proof/15">
            <span class="absolute right-5 top-4 font-mono text-xs text-proof/50">0{index + 1}</span>
            <h3 class="pr-8 text-lg font-semibold text-text-primary">{r.items[key]}</h3>
            <p class="mt-3 text-sm leading-relaxed text-text-secondary">{r.items[`${key}Desc`]}</p>
          </article>
        ))}
      </div>

      <div class="reveal mt-7 flex flex-wrap gap-3">
        <a href={releaseDocs[locale]} class="receipt-link inline-flex items-center gap-2 text-sm text-proof-light hover:text-proof">
          <span>{r.receipts.candidateNotes}</span>
          <span class="receipt-arrow ms-icon ms-icon-sm">arrow_outward</span>
        </a>
        <a href="https://github.com/achronyme/achronyme/pull/92" target="_blank" rel="noopener noreferrer" class="receipt-link inline-flex items-center gap-2 text-sm text-text-muted hover:text-text-primary">
          <span>Core PR #92</span>
          <span class="receipt-arrow ms-icon ms-icon-sm">arrow_outward</span>
        </a>
      </div>
    </section>

    <section id="next" class="relative border-b border-subtle/77 px-7 py-12 pl-16 sm:px-10 sm:pl-20 lg:px-16 lg:pl-24">
      <span aria-hidden="true" class="absolute left-[25px] top-14 h-3.5 w-3.5 rounded-full bg-info/60 ring-4 ring-info/10 md:left-[41px]"></span>
      <header class="reveal">
        <div class="flex flex-wrap items-center gap-3">
          <span class="rounded-full bg-info/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.16em] text-info ring-1 ring-info/20">{r.status.planned}</span>
          <span class="font-mono text-sm text-text-muted">{r.phases.next.anchor}</span>
        </div>
        <h2 class="mt-4 text-3xl font-bold tracking-tight">{r.phases.next.label}</h2>
        <p class="mt-3 max-w-3xl text-text-muted">{r.phases.next.desc}</p>
      </header>

      <div class="reveal-stagger mt-8 grid gap-4 md:grid-cols-2">
        {nextItems.map((key) => (
          <article class="reveal rounded-2xl bg-info/[0.035] p-6 ring-1 ring-info/12">
            <h3 class="font-semibold text-text-primary">{r.items[key]}</h3>
            <p class="mt-3 text-sm leading-relaxed text-text-secondary">{r.items[`${key}Desc`]}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="research" class="relative border-b border-subtle/77 px-7 py-12 pl-16 sm:px-10 sm:pl-20 lg:px-16 lg:pl-24">
      <span aria-hidden="true" class="absolute left-[25px] top-14 h-3.5 w-3.5 rounded-full bg-text-muted/50 ring-4 ring-text-muted/10 md:left-[41px]"></span>
      <header class="reveal">
        <div class="flex flex-wrap items-center gap-3">
          <span class="rounded-full bg-white/[0.04] px-3 py-1 text-xs font-semibold uppercase tracking-[0.16em] text-text-muted ring-1 ring-white/[0.08]">{r.status.exploratory}</span>
          <span class="font-mono text-sm text-text-muted">{r.phases.later.anchor}</span>
        </div>
        <h2 class="mt-4 text-3xl font-bold tracking-tight text-text-secondary">{r.phases.later.label}</h2>
        <p class="mt-3 max-w-3xl text-text-muted">{r.phases.later.desc}</p>
      </header>

      <div class="reveal-stagger mt-8 grid gap-4 lg:grid-cols-3">
        {researchItems.map((key) => (
          <article class="reveal rounded-2xl border border-dashed border-white/[0.10] p-6">
            <h3 class="font-semibold text-text-secondary">{r.items[key]}</h3>
            <p class="mt-3 text-sm leading-relaxed text-text-muted">{r.items[`${key}Desc`]}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="target" class="relative px-7 py-12 pl-16 sm:px-10 sm:pl-20 lg:px-16 lg:pl-24">
      <span aria-hidden="true" class="absolute left-[24px] top-14 h-4 w-4 rounded-full bg-gradient-to-br from-proof to-info ring-4 ring-proof/10 md:left-[40px]"></span>
      <div class="reveal max-w-3xl rounded-2xl bg-gradient-to-br from-proof/[0.07] to-info/[0.04] p-7 ring-1 ring-proof/15">
        <span class="text-xs font-semibold uppercase tracking-[0.16em] text-proof-light">{r.status.target} {r.phases.target.anchor}</span>
        <h2 class="mt-3 text-2xl font-bold tracking-tight">{r.items.apiFreeze}</h2>
        <p class="mt-3 text-sm leading-relaxed text-text-secondary">{r.items.apiFreezeDesc}</p>
      </div>
    </section>
  </div>
</div>
<ScrollReveal />
